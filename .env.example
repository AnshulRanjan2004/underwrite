# Branding
NEXT_PUBLIC_APP_NAME=Underwrite
NEXT_PUBLIC_APP_SHORT_NAME=UW

# Automatic provider selection checks these in order when AI_PROVIDER is unset.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional explicit server-side provider: openai | gemini | ollama | demo
AI_PROVIDER=demo

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Only enable on a trusted self-hosted production server that must reach a
# private Ollama, vLLM, or LM Studio endpoint.
ALLOW_PRIVATE_MODEL_ENDPOINTS=false

